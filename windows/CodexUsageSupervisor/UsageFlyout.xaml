<Window x:Class="CodexUsageSupervisor.UsageFlyout" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Codex Usage Supervisor" Width="380" Height="640" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Background="#121C26" FontFamily="Segoe UI" FontSize="13">
 <Border BorderBrush="#344250" BorderThickness="1" Padding="24,20">
  <DockPanel>
   <StackPanel DockPanel.Dock="Top">
    <Grid Margin="0,0,0,18"><TextBlock Text="CODEX" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="USAGE SUPERVISOR" Foreground="#8B9BAA" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <TextBlock Text="账户用量 · 已用比例" Foreground="#8B9BAA" Margin="0,0,0,17"/>
    <Grid><TextBlock x:Name="PrimaryLabel" Text="5 小时"/><TextBlock x:Name="PrimaryValue" Text="—" HorizontalAlignment="Right" FontSize="21"/></Grid>
    <ProgressBar x:Name="PrimaryBar" Height="5" Margin="0,9,0,7" Maximum="100" Background="#293644" Foreground="#66DEB0" BorderThickness="0"/>
    <TextBlock x:Name="PrimaryReset" Text="正在获取账户额度…" Foreground="#8B9BAA" FontSize="11" Margin="0,0,0,20"/>
    <Grid><TextBlock x:Name="SecondaryLabel" Text="每周"/><TextBlock x:Name="SecondaryValue" Text="—" HorizontalAlignment="Right" FontSize="21"/></Grid>
    <ProgressBar x:Name="SecondaryBar" Height="5" Margin="0,9,0,7" Maximum="100" Background="#293644" Foreground="#66DEB0" BorderThickness="0"/>
    <TextBlock x:Name="SecondaryReset" Text="—" Foreground="#8B9BAA" FontSize="11" Margin="0,0,0,23"/>
    <TextBlock Text="今日活动 · 本机估算" Foreground="#8B9BAA" FontSize="11"/>
    <TextBlock x:Name="Today" Text="—" FontSize="18" Margin="0,8,0,22"/>
    <TextBlock Text="最近任务" Foreground="#8B9BAA" FontSize="11" Margin="0,0,0,8"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
    <TextBlock x:Name="Status" Text="连接中…" Foreground="#8B9BAA" FontSize="11" MaxHeight="55" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
    <StackPanel Orientation="Horizontal"><Button x:Name="RefreshButton" Content="刷新" Click="RefreshClick"/><Button Content="设置" Click="SettingsClick"/><Button Content="收起" Click="HideClick"/></StackPanel>
   </StackPanel>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Recent"/></ScrollViewer>
  </DockPanel>
 </Border>
</Window>
